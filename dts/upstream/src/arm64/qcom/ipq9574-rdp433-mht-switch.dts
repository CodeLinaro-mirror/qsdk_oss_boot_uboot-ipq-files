/dts-v1/;

#include "ipq9574-rdp-common.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. IPQ9574/RDP433-MHT-SWITCH";
	compatible = "qcom,ipq9574-rdp433-mht-switch", "qcom,ipq9574";

	soc@0 {
		mdio: mdio@90000 {
			pinctrl-names = "default";
			pinctrl-0 = <&mdio_pinmux>;
			status = "okay";

			phy0: ethernet-switch@1 {
				phy-reset-gpio = <&tlmm 60 0>;
				dev-mode = <0x1>;
				phy_addr = <1>;
				phy_type = <QCA8x8x_SWITCH_TYPE>;
				id = <1>;
				uniphy_id = <0>;
				uniphy_type = <0>;
				max_speed = <2500>;
				force-speed;
				xgmac;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port0: port@0 {
						phy_addr = <0>;
						label = "cpu";
						phy-mode = "2500base-x";
						fixed-link {
							speed = <2500>;
							full-duplex;
						};
					};

					port1: port@1 {
						phy_addr = <1>;
						label = "lan";
					};

					port2: port@2 {
						phy_addr = <2>;
						label = "lan";
					};

					port3: port@3 {
						phy_addr = <3>;
						label = "lan";
					};

					port4: port@4 {
						phy_addr = <4>;
						label = "lan";
					};
				};
			};

			phy4: phy@8 {
				phy-reset-gpio = <&tlmm 36 0>;
				phy_addr = <8>;
				phy_type = <AQ_PHY_TYPE>;
				phy-mode = "usxgmii";
				id = <5>;
				uniphy_id = <1>;
				uniphy_type = <1>;
				xgmac;
			};

			phy5: phy@0 {
				phy_addr = <0>;
				phy_type = <AQ_PHY_TYPE>;
				phy-mode = "usxgmii";
				id = <6>;
				uniphy_id = <2>;
				uniphy_type = <0>;
				xgmac;
			};
		};

		ethernet: nss-switch {
			pinctrl-names = "default";
			pinctrl-0 = <&phy_rst_pinmux>;
			phy-handle0 = <&phy0>;
			phy-handle4 = <&phy4>;
			phy-handle5 = <&phy5>;
			status = "okay";
		};
	};
};

&tlmm {
	mdio_pinmux: mdio {
		mdc {
			pins = "gpio38";
			function = "mdc";
			drive-strength = <8>;
			bias-disable;
		};

		mdio {
			pins = "gpio39";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	phy_rst_pinmux: phy_rst {
		qti_8x8x_rst {
			pins = "gpio60";
			drive-strength = <8>;
			bias-pull-up;
		};

		qti_aquantia_rst {
			pins = "gpio36";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};
