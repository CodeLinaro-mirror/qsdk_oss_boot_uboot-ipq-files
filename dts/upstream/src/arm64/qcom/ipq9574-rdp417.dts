/dts-v1/;

#include "ipq9574-rdp-common.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. IPQ9574/RDP417";
	compatible = "qcom,ipq9574-rdp417", "qcom,ipq9574";

	soc@0 {
		mdio: mdio@90000 {
			pinctrl-names = "default";
			pinctrl-0 = <&mdio_pinmux>;
			status = "okay";

			phy0: phy@16 {
				phy-reset-gpio = <&tlmm 60 0>;
				phy_addr = <16>;
				phy_type = <QCA8075_PHY_TYPE>;
				id = <1>;
				uniphy_id = <0>;
				uniphy_type = <0>;
			};

			phy1: phy@17 {
				phy_addr = <17>;
				phy_type = <QCA8075_PHY_TYPE>;
				id = <2>;
				uniphy_id = <0>;
				uniphy_type = <0>;
			};

			phy2: phy@18 {
				phy_addr = <18>;
				phy_type = <QCA8075_PHY_TYPE>;
				id = <3>;
				uniphy_id = <0>;
				uniphy_type = <0>;
			};

			phy3: phy@19 {
				phy_addr = <19>;
				phy_type = <QCA8075_PHY_TYPE>;
				id = <4>;
				uniphy_id = <0>;
				uniphy_type = <0>;
			};

			phy4: phy@20 {
				phy_addr = <20>;
				phy_type = <QCA8075_PHY_TYPE>;
				id = <5>;
				uniphy_id = <0>;
				uniphy_type = <0>;
			};

			phy5: phy@0 {
				phy-reset-gpio = <&tlmm 36 0>;
				phy_addr = <0>;
				phy_type = <AQ_PHY_TYPE>;
				phy-mode = "usxgmii";
				id = <6>;
				uniphy_id = <2>;
				uniphy_type = <0>;
				xgmac;
			};
		};

		ethernet: nss-switch {
			pinctrl-names = "default";
			pinctrl-0 = <&phy_rst_pinmux>;
			phy-handle0 = <&phy0>;
			phy-handle1 = <&phy1>;
			phy-handle2 = <&phy2>;
			phy-handle3 = <&phy3>;
			phy-handle4 = <&phy4>;
			phy-handle5 = <&phy5>;
			status = "okay";
		};
	};
};

&tlmm {
	mdio_pinmux: mdio {
		mdc {
			pins = "gpio38";
			function = "mdc";
			drive-strength = <8>;
			bias-disable;
		};

		mdio {
			pins = "gpio39";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	phy_rst_pinmux: phy_rst {
		qti_8085_rst {
			pins = "gpio60";
			drive-strength = <8>;
			bias-pull-up;
		};

		qti_aquantia_rst {
			pins = "gpio36";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};
