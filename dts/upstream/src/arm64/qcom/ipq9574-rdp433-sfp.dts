/dts-v1/;

#include "ipq9574-rdp-common.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. IPQ9574/RDP433-SFP";
	compatible = "qcom,ipq9574-rdp433-sfp", "qcom,ipq9574";

	soc@0 {
		mdio: mdio@90000 {
			pinctrl-names = "default";
			pinctrl-0 = <&mdio_pinmux>;
			status = "okay";

			phy4: phy@8 {
				phy-reset-gpio = <&tlmm 36 0>;
				phy_addr = <8>;
				phy_type = <AQ_PHY_TYPE>;
				phy-mode = "usxgmii";
				id = <5>;
				uniphy_id = <1>;
				uniphy_type = <1>;
				xgmac;
			};

			phy5: phy@0 {
				phy_addr = <0>;
				phy_type = <AQ_PHY_TYPE>;
				phy-mode = "usxgmii";
				id = <6>;
				uniphy_id = <2>;
				uniphy_type = <0>;
				xgmac;
			};
		};

		ethernet: nss-switch {
			pinctrl-names = "default";
			pinctrl-0 = <&phy_rst_pinmux>;
			phy-handle0 = <&phy0>;
			phy-handle1 = <&phy4>;
			phy-handle2 = <&phy5>;
			tdm_mode = <1>;
			status = "okay";

			phy0: phy@ff {
				phy_addr = <0xFF>;
				phy_type = <SFP10G_PHY_TYPE>;
				id = <1>;
				uniphy_id = <0>;
				uniphy_type = <0>;
				max_speed = <10000>;
				xgmac;
			};
		};

		pcie1: pci@10000000 {
			pinctrl-names = "default";
			pinctrl-0 = <&pci1_pin>;
			status = "okay";
			perst-gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;
		};

		pcie2: pci@20000000 {
			pinctrl-names = "default";
			pinctrl-0 = <&pci2_pin>;
			status = "okay";
			perst-gpios = <&tlmm 29 GPIO_ACTIVE_LOW>;
		};

		pcie3: pci@18000000 {
			pinctrl-names = "default";
			pinctrl-0 = <&pci3_pin>;
			status = "okay";
			perst-gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
		};
	};
};

&tlmm {
	mdio_pinmux: mdio {
		mdc {
			pins = "gpio38";
			function = "mdc";
			drive-strength = <8>;
			bias-disable;
		};

		mdio {
			pins = "gpio39";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	phy_rst_pinmux: phy_rst {
		qti_8085_rst {
			pins = "gpio60";
			drive-strength = <8>;
			bias-pull-up;
		};

		qti_aquantia_rst {
			pins = "gpio36";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	pci1_pin: pci1-default-state {
		pins = "gpio26";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-low;
	};

	pci2_pin: pci2-default-state {
		pins = "gpio29";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
		output-low;
	};

	pci3_pin: pci3-default-state {
		pins = "gpio32";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-low;
	};
};
