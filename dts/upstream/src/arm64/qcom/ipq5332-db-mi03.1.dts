/dts-v1/;

#include "ipq5332-rdp-common.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. IPQ5332 DB-MI03.1";
	compatible = "qcom,ipq5332-db-mi03.1", "qcom,ipq5332";

	soc@0 {
		mdio: mdio@90000 {
			pinctrl-names = "default";
			pinctrl-0 = <&mdio_pinmux>;
			status = "okay";

			phy0: phy@8 {
				phy-reset-gpio = <&tlmm 22 0>;
				phy_addr = <8>;
				phy_type = <AQ_PHY_TYPE>;
				phy-mode = "usxgmii";
				id = <1>;
				uniphy_id = <0>;
				uniphy_type = <0>;
				xgmac;
			};

			phy1: phy@0 {
				phy-reset-gpio = <&tlmm 24 0>;
				phy_addr = <0>;
				phy_type = <AQ_PHY_TYPE>;
				phy-mode = "usxgmii";
				id = <2>;
				uniphy_id = <1>;
				uniphy_type = <0>;
				xgmac;
			};
		};

		ethernet: nss-switch {
			pinctrl-names = "default";
			pinctrl-0 = <&phy_rst_pinmux>;
			phy-handle0 = <&phy0>;
			phy-handle1 = <&phy1>;
			status = "okay";
		};
	};
};

&tlmm {
	mdio_pinmux: mdio {
		mdc {
			pins = "gpio27";
			function = "mdc1";
			drive-strength = <8>;
			bias-disable;
		};

		mdio {
			pins = "gpio28";
			function = "mdio1";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	phy_rst_pinmux: phy_rst {
		qti_aquantia_p1_rst {
			pins = "gpio22";
			drive-strength = <8>;
			bias-pull-up;
		};

		qti_aquantia_p2_rst {
			pins = "gpio24";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};
