/dts-v1/;

#include "ipq5210-u-boot.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. IPQ5210 DB-HM01.1";
	compatible = "qcom,ipq5210-db-hm01.1", "qcom,ipq5210";

	aliases {
		serial0 = &uart1;
	};

	soc@0 {
		qmp_ssphy_0: ssphy@7D000 {
			status = "okay";
		};

		qusb2_phy_0: qusb2_0@7B000 {
			status = "okay";
		};

		usb3_1: usb3_1@8af8800 {
			status = "okay";
		};

		pcie0: pcie@70000000 {
			pinctrl-0 = <&pcie0_default_state>;
			pinctrl-names = "default";
			perst-gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
			status = "okay";
		};

		pcie1: pcie@50000000 {
			pinctrl-0 = <&pcie1_default_state>;
			pinctrl-names = "default";
			perst-gpios = <&tlmm 29 GPIO_ACTIVE_LOW>;
			status = "okay";
		};

		mdio: mdio@90000 {
			status = "okay";
			phy4: phy@8 {
				phy-reset-gpio = <&tlmm 45 0>;
				phy_addr = <8>;
				phy_type = <QCA81xx_PHY_TYPE>;
				id = <5>;
				uniphy_id = <1>;
				uniphy_type = <1>;
				xgmac;
			};
		};

		ess_instance: ess-instance {
			pinctrl-names = "default";
			pinctrl-0 = <&phy_rst_pinmux>;
			phy-handle0 = <&phy4>;
			status = "okay";
		};
	};
};

&tlmm {
	pcie0_default_state: pcie0-default-state {
		perst-n-pins {
			pins = "gpio32";
			function = "gpio";
			drive-strength = <6>;
			bias-pull-down;
			output-low;
		};
	};

	pcie1_default_state: pcie1-default-state {
		perst-n-pins {
			pins = "gpio29";
			function = "gpio";
			drive-strength = <6>;
			bias-pull-down;
			output-low;
		};
	};

	phy_rst_pinmux: phy_rst {
		qti_laguna0_rst {
			pins = "gpio45";
			drive-strength = <2>;
			bias-pull-up;
			output-high;
		};
	};
};

&tmel_qmp {
	status = "okay";
};

&tmelcom {
	status = "okay";
};
