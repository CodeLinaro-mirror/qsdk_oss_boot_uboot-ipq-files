#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <asm/arch/dt-bindings/clock/qcom,ipq9650-gcc.h>
#include <asm/arch/dt-bindings/reset/qcom,ipq9650-gcc.h>
#include <dt-bindings/gpio/gpio.h>
/ {
	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&intc>;

	aliases {
		serial0 = &uart1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
#ifdef CONFIG_BOOT_BANK_FIXUP
		u-boot,booted-bank = "unknown,bootbank";
#endif
	};

	clocks {
		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <32000>;
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/delete-node/ smem;
		smem_mem: smem_region@8a500000 {
			reg = <0x0 0x8a500000 0x0 0x40000>;
			no-map;
		};

		tfa: tfa_region@0x8a600000 {
			reg = <0x0 0x8a600000 0x0 0x80000>;
			no-map;
		};

		optee: optee_region@0x8a680000 {
			reg = <0x0 0x8a680000 0x0 0x280000>;
			no-map;
		};
	};

	smem {
		compatible = "qcom,smem";
		memory-region = <&smem_mem>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	soc@0 {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges = <0 0 0 0 0x10 0>;

		tlmm: pinctrl@1000000 {
			compatible = "qcom,ipq9650-tlmm";
			reg = <0 0x01000000 0 0x300000>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&tlmm 0 0 53>;
			interrupt-controller;
			#interrupt-cells = <2>;

			uart1_pins: uart1-state {
				rx-pins {
					pins = "gpio43";
					function = "qup_se4_l3";
					drive-strength = <8>;
					bias-pull-down;
				};

				tx-pins {
					pins = "gpio44";
					function = "qup_se4_l2";
					drive-strength = <8>;
					bias-pull-down;
				};
			};
		};

		intc: interrupt-controller@f200000 {
			compatible = "arm,gic-v3";
			reg = <0x0 0x0f200000 0x0 0x10000>, /* GICD */
			      <0x0 0x0f240000 0x0 0xa0000>; /* GICR * 5 regions */
			#interrupt-cells = <0x3>;
			interrupt-controller;
			#redistributor-regions = <1>;
			redistributor-stride = <0x0 0x20000>;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
		};

		tmel_qmp: tmel-qmp@22090000 {
			compatible = "qcom,tmel-qmp-mbox";
			reg = <0x0 0x22090000 0x0 0x20>,
			      <0x0 0x22091000 0x0 0x20>;
			reg-names = "mcore", "ucore";

			interrupts = <GIC_SPI 126 IRQ_TYPE_EDGE_RISING>;
			max_pkt_size = <0x18>;

			#mbox-cells = <0>;
			status = "disabled";
		};

		tmelcom: qcom,tmelcom {
			compatible = "qcom,tmelcom";
			mboxes = <&tmel_qmp>;
			mbox-names = "tmel-qmp-mbox";
			#clock-cells = <1>;
			#power-domain-cells = <1>;
			#reset-cells = <1>;
			status = "disabled";
		};

		gcc: clock-controller@1800000 {
			compatible = "qcom,ipq9650-gcc";
			reg = <0 0x01800000 0 0x40000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
			#power-domain-cells = <1>;
		};

		qupv3: geniqup@1ac0000 {
			compatible = "qcom,geni-se-qup";
			reg = <0 0x01ac0000 0 0x2000>;
			clocks = <&gcc GCC_QUPV3_AHB_MST_CLK>,
				 <&gcc GCC_QUPV3_AHB_SLV_CLK>;
			clock-names = "m-ahb", "s-ahb";
			ranges;
			#address-cells = <2>;
			#size-cells = <2>;

			status = "disabled";

			uart1: serial@1a98000 {
				compatible = "qcom,geni-debug-uart";
				reg = <0 0x1a98000 0 0x4000>;
				clocks = <&gcc GCC_QUPV3_UART2_CLK>;
				clock-names = "se";
				status = "disabled";
			};
		};

		sdhc: mmc@7804000 {
			compatible = "qcom,ipq9650-sdhci", "qcom,sdhci-msm-v5";
			reg = <0 0x07804000 0 0x1000>, <0 0x07805000 0 0x1000>;
			reg-names = "hc", "cqhci";

			clocks = <&gcc GCC_SDCC1_AHB_CLK>,
				 <&gcc GCC_SDCC1_APPS_CLK>;
			clock-names = "iface", "core";

			status = "disabled";
		};

		nand: nand-controller@79B0000 {
			compatible = "qti,spi-nand-v2.1.3";
			#address-cells = <2>;
			#size-cells = <2>;
			reg = <0x0 0x79B0000 0x0 0x10000>;
			assigned-clocks = <&gcc GCC_QPIC_CLK>,
					 <&gcc GCC_QPIC_IO_MACRO_CLK>;
			assigned-clock-rates = <100000000>, <200000000>;
			clock-names = "qpic-clk",
				      "qpic-io-macro-clk",
				      "qpic-ahb-clk";
			clocks = <&gcc GCC_QPIC_CLK>,
				<&gcc GCC_QPIC_IO_MACRO_CLK>,
				<&gcc GCC_QPIC_AHB_CLK>;

			bam_reg = <0x07984000>;
			status_pipe = <3>;
			status_pipe_grp = <0>;
			read_pipe = <1>;
			read_pipe_grp = <0>;
			write_pipe = <0>;
			write_pipe_grp = <0>;
			cmd_pipe = <2>;
			cmd_pipe_grp = <1>;
			pinctrl-0 = <&qspi_pinmux>;
			pinctrl-names = "default";
			status = "okay";
		};

		qmp_ssphy_0: ssphy@7d000 {
			compatible = "qcom,ipq9650-qmp-usb3-phy";
			#address-cells = <2>;
			#size-cells = <2>;
			reg = <0x0 0x7d000 0x0 0x1c0>,
				<0x0 0x7d200 0x0 0x170>,
				<0x0 0x7d400 0x0 0x200>,
				<0x0 0x7d800 0x0 0x1f0>;
			reg-names = "com_base", "tx_base",
				"rx_base", "pcs_base";
			clocks = <&gcc GCC_USB0_PIPE_CLK>;
			#phy-cells = <0>;
			resets =  <&gcc GCC_USB0_PHY_BCR>,
			       <&gcc GCC_USB3PHY_0_PHY_BCR>;
			status = "disabled";
		};

		qusb2_phy_0: qusb2_0@7b000 {
			compatible = "qcom,ipq9650-usb-hs-phy";
			#address-cells = <2>;
			#size-cells = <2>;
			reg = <0x0 0x07b000 0x0 0x114>;
			#phy-cells = <0>;
			clocks = <&gcc GCC_USB0_PHY_CFG_AHB_CLK>;
			clock-names = "cfg_ahb";

			resets = <&gcc GCC_QUSB2_0_PHY_BCR>;
			status = "disabled";
		};

		qusb2_phy_1: qusb2_1@71000 {
			compatible = "qcom,ipq9650-usb-hs-phy";
			#address-cells = <2>;
			#size-cells = <2>;
			reg = <0x0 0x071000 0x0 0x114>;
			#phy-cells = <0>;
			clocks = <&gcc GCC_USB1_PHY_CFG_AHB_CLK>;
			clock-names = "cfg_ahb";
			resets = <&gcc GCC_QUSB2_1_PHY_BCR>;
			status = "disabled";
		};

		usb3_0: usb3_0@8af8800 {
			compatible = "qcom,dwc3";
			reg = <0x0 0x8af8800 0x0 0x100>;
			#address-cells = <2>;
			#size-cells = <2>;
			assigned-clocks = <&gcc GCC_USB0_MASTER_CLK>,
				<&gcc GCC_USB0_MOCK_UTMI_CLK>,
				<&gcc GCC_USB0_AUX_CLK>;
			assigned-clock-rates = <200000000>,
				<60000000>,
				<24000000>;
			clocks = <&gcc GCC_USB0_MASTER_CLK>,
				<&gcc GCC_USB0_AUX_CLK>,
				<&gcc GCC_USB0_SLEEP_CLK>,
				<&gcc GCC_USB0_MOCK_UTMI_CLK>,
				<&gcc GCC_USB0_PHY_CFG_AHB_CLK>;
			resets = <&gcc GCC_USB_BCR>;
			ranges;
			qcom,quirk-ref-clk-per = <0x4004010>;
			qcom,quirk-ref-clk-adj = <0x4945720>;
			status = "disabled";

			dwc3@8a00000 {
				compatible = "snps,dwc3";
				reg = <0x0 0x8a00000 0x0 0xf8000>;
				dr_mode = "host";
				snps,dis_u2_susphy_quirk;
				snps,dis_u3_susphy_quirk;
				phys = <&qusb2_phy_0>, <&qmp_ssphy_0>;
				phy-names = "usb2-phy", "usb3-phy";
				maximum-speed = "super-speed";
			};
		};

		/*
		* usb3_1 node configuration makes usb 3.0 controller
		* to use usb 3.0 devices as usb 2.0 device
		*/
		usb3_1: usb3_1@8af8800 {
			compatible = "qcom,dwc3";
			reg = <0x0 0x8af8800 0x0 0x100>;
			#address-cells = <2>;
			#size-cells = <2>;
			assigned-clocks = <&gcc GCC_USB0_MASTER_CLK>,
				<&gcc GCC_USB0_MOCK_UTMI_CLK>,
				<&gcc GCC_USB0_AUX_CLK>;
			assigned-clock-rates = <200000000>,
				<60000000>,
				<24000000>;
			clocks = <&gcc GCC_USB0_MASTER_CLK>,
				<&gcc GCC_USB0_AUX_CLK>,
				<&gcc GCC_USB0_SLEEP_CLK>,
				<&gcc GCC_USB0_MOCK_UTMI_CLK>,
				<&gcc GCC_USB0_PHY_CFG_AHB_CLK>;
			resets = <&gcc GCC_USB_BCR>;
			ranges;
			qcom,quirk-ref-clk-per = <0x4004010>;
			qcom,quirk-ref-clk-adj = <0x4945720>;
			qcom,select-utmi-as-pipe-clk;
			status = "disabled";

			dwc3@8a00000 {
				compatible = "snps,dwc3";
				reg = <0x0 0x8a00000 0x0 0xf8000>;
				dr_mode = "host";
				snps,dis_u2_susphy_quirk;
				snps,dis_u3_susphy_quirk;
				phys = <&qusb2_phy_0>;
				phy-names = "usb2-phy";
				maximum-speed = "high-speed";
			};
		};

		usb2_0: usb2_0@1ef8800 {
			compatible = "qcom,dwc3";
			reg = <0x0 0x1ef8800 0x0 0x100>;
			#address-cells = <2>;
			#size-cells = <2>;
			assigned-clocks = <&gcc GCC_USB1_MOCK_UTMI_CLK>;
			assigned-clock-rates = <60000000>;
			clocks = <&gcc GCC_USB1_MASTER_CLK>,
				<&gcc GCC_SNOC_USB_CLK>,
				<&gcc GCC_USB1_SLEEP_CLK>,
				<&gcc GCC_USB1_MOCK_UTMI_CLK>,
				<&gcc GCC_USB1_PHY_CFG_AHB_CLK>;
			resets = <&gcc GCC_USB1_BCR>;
			ranges;
			qcom,select-utmi-as-pipe-clk;
			qcom,quirk-ref-clk-per = <0x4004010>;
			qcom,quirk-ref-clk-adj = <0x4945720>;
			status = "disabled";

			dwc3@1e00000 {
				compatible = "snps,dwc3";
				reg = <0x0 0x1e00000 0x0 0xf8000>;
				dr_mode = "host";
				snps,dis_u2_susphy_quirk;
				snps,dis_u3_susphy_quirk;
				phys = <&qusb2_phy_1>;
				phy-names = "usb2-phy";
				maximum-speed = "high-speed";
			};
		};

		pcie0_phy: phy@84000 {
			compatible = "qcom,ipq9650-qmp-gen3x1-pcie-phy";
			reg = <0x0 0x00084000 0x0 0x1c0>; /* Serdes PLL */
			#address-cells = <1>;
			#size-cells = <1>;

			clocks = <&gcc GCC_PCIE0_AUX_CLK>,
				 <&gcc GCC_PCIE0_AHB_CLK>,
				 <&gcc GCC_PCIE0_RCHNG_CLK>,
				 <&gcc GCC_PCIE0_PIPE_CLK>,
				 <&gcc GCC_ANOC_PCIE0_1LANE_M_CLK>,
				 <&gcc GCC_ANOC_PCIE0_1LANE_S_CLK>;
			clock-names = "aux", "cfg_ahb", "rchng", "pipe",
					"lane_m", "lane_s";

			resets = <&gcc GCC_PCIE0_PHY_BCR>,
				 <&gcc GCC_PCIE0PHY_PHY_BCR>;
			reset-names = "phy", "common";

			#phy-cells = <0>;
			status = "disabled";
		};

		pcie4_phy: phy@8c000 {
			compatible = "qcom,ipq9650-qmp-gen3x1-pcie-phy";
			reg = <0x0 0x0008c000 0x0 0x1c0>; /* Serdes PLL */
			#address-cells = <1>;
			#size-cells = <1>;

			clocks = <&gcc GCC_PCIE4_AUX_CLK>,
				 <&gcc GCC_PCIE4_AHB_CLK>,
				 <&gcc GCC_PCIE4_RCHNG_CLK>,
				 <&gcc GCC_PCIE4_PIPE_CLK>,
				 <&gcc GCC_ANOC_PCIE4_1LANE_M_CLK>,
				 <&gcc GCC_ANOC_PCIE4_1LANE_S_CLK>;
			clock-names = "aux", "cfg_ahb", "rchng", "pipe",
					"lane_m", "lane_s";

			resets = <&gcc GCC_PCIE4_PHY_BCR>,
				 <&gcc GCC_PCIE4PHY_PHY_BCR>;
			reset-names = "phy", "common";

			#phy-cells = <0>;
			status = "disabled";
		};

		pcie3_phy: phy@b4000 {
			compatible = "qcom,ipq9650-qmp-gen3x2-pcie-phy";
			reg = <0x0 0x000b4000 0x0 0x1c0>; /* Serdes PLL */
			#address-cells = <1>;
			#size-cells = <1>;

			clocks = <&gcc GCC_PCIE3_AUX_CLK>,
				 <&gcc GCC_PCIE3_AHB_CLK>,
				 <&gcc GCC_PCIE3_RCHNG_CLK>,
				 <&gcc GCC_PCIE3_PIPE_CLK>,
				 <&gcc GCC_ANOC_PCIE3_2LANE_M_CLK>,
				 <&gcc GCC_ANOC_PCIE3_2LANE_S_CLK>;
			clock-names = "aux", "cfg_ahb", "rchng", "pipe",
					"lane_m", "lane_s";

			resets = <&gcc GCC_PCIE3_PHY_BCR>,
				 <&gcc GCC_PCIE3PHY_PHY_BCR>;
			reset-names = "phy", "common";

			#phy-cells = <0>;
			status = "disabled";
		};

		pcie1_phy: phy@f4000 {
			compatible = "qcom,ipq9650-qmp-gen3x2-pcie-phy";
			reg = <0x0 0x000f4000 0x0 0x1c0>; /* Serdes PLL */
			#address-cells = <1>;
			#size-cells = <1>;

			clocks = <&gcc GCC_PCIE1_AUX_CLK>,
				 <&gcc GCC_PCIE1_AHB_CLK>,
				 <&gcc GCC_PCIE1_RCHNG_CLK>,
				 <&gcc GCC_PCIE1_PIPE_CLK>,
				 <&gcc GCC_ANOC_PCIE1_2LANE_M_CLK>,
				 <&gcc GCC_ANOC_PCIE1_2LANE_S_CLK>;
			clock-names = "aux", "cfg_ahb", "rchng", "pipe",
					"lane_m", "lane_s";

			resets = <&gcc GCC_PCIE1_PHY_BCR>,
				 <&gcc GCC_PCIE1PHY_PHY_BCR>;
			reset-names = "phy", "common";

			#phy-cells = <0>;
			status = "disabled";
		};

		pcie2_phy: phy@fc000 {
			compatible = "qcom,ipq9650-qmp-gen3x2-pcie-phy";
			reg = <0x0 0x000fc000 0x0 0x1c0>; /* Serdes PLL */
			#address-cells = <1>;
			#size-cells = <1>;

			clocks = <&gcc GCC_PCIE2_AUX_CLK>,
				 <&gcc GCC_PCIE2_AHB_CLK>,
				 <&gcc GCC_PCIE2_RCHNG_CLK>,
				 <&gcc GCC_PCIE2_PIPE_CLK>,
				 <&gcc GCC_ANOC_PCIE2_2LANE_M_CLK>,
				 <&gcc GCC_ANOC_PCIE2_2LANE_S_CLK>;
			clock-names = "aux", "cfg_ahb", "rchng", "pipe",
					"lane_m", "lane_s";

			resets = <&gcc GCC_PCIE2_PHY_BCR>,
				 <&gcc GCC_PCIE2PHY_PHY_BCR>;
			reset-names = "phy", "common";

			#phy-cells = <0>;
			status = "disabled";
		};

		/* 2L controller */
		pcie3: pcie@30000000 {
			compatible = "qcom,pcie-ipq9650";
			reg =  <0x0 0x30000000 0x0 0xf1d>,
			       <0x0 0x30000f20 0x0 0xa8>,
			       <0x0 0x30001000 0x0 0x1000>,
			       <0x0 0xb0000 0x0 0x3000>,
			       <0x0 0x30100000 0x0 0x1000>;
			reg-names = "dbi", "elbi", "atu", "parf", "config";
			device_type = "pci";
			linux,pci-domain = <3>;
			bus-range = <0x00 0xff>;
			num-lanes = <2>;
			#address-cells = <3>;
			#size-cells = <2>;
			axi-halt-val = <0x1e>; /* increase halt window size to 1GB */
			id = <3>;

			ranges = <0x81000000 0 0x30200000 0x0 0x30200000 0 0x00100000>,   /* downstream I/O */
				 <0x82000000 0 0x30300000 0x0 0x30300000 0 0x0fd00000>; /* non-prefetchable memory */

			clocks = <&gcc GCC_PCIE3_AXI_M_CLK>,
				 <&gcc GCC_PCIE3_AXI_S_CLK>,
				 <&gcc GCC_PCIE3_AHB_CLK>,
				 <&gcc GCC_PCIE3_AUX_CLK>,
				 <&gcc GCC_PCIE3_AXI_S_BRIDGE_CLK>;

			clock-names = "axi_m",
				      "axi_s",
				      "ahb",
				      "aux",
				      "axi_bridge";

			assigned-clocks = <&gcc GCC_PCIE3_AUX_CLK>,
					<&gcc GCC_PCIE3_AXI_M_CLK>,
					<&gcc GCC_PCIE3_AXI_S_CLK>,
					<&gcc GCC_PCIE3_RCHNG_CLK>;

			assigned-clock-rates = <20000000>,
						<266666666>,
						<200000000>,
						<100000000>;

			resets = <&gcc GCC_PCIE3_PIPE_ARES>,
				 <&gcc GCC_PCIE3_CORE_STICKY_RESET>,
				 <&gcc GCC_PCIE3_AXI_M_ARES>,
				 <&gcc GCC_PCIE3_AXI_S_ARES>,
				 <&gcc GCC_PCIE3_AXI_M_STICKY_RESET>,
				 <&gcc GCC_PCIE3_AXI_S_STICKY_RESET>,
				 <&gcc GCC_PCIE3_AHB_ARES>,
				 <&gcc GCC_PCIE3_AUX_ARES>;

			reset-names = "pipe",
				      "sticky",
				      "axi_m",
				      "axi_s",
				      "axi_m_sticky",
				      "axi_s_sticky",
				      "ahb",
				      "aux";

			msi-parent = <&intc>;

			phys = <&pcie3_phy>;
			phy-names = "pciephy";

			status = "disabled";
		};

		/* 2L controller */
		pcie2: pcie@40000000 {
			compatible = "qcom,pcie-ipq9650";
			reg =  <0x0 0x40000000 0x0 0xf1d>,
			       <0x0 0x40000f20 0x0 0xa8>,
			       <0x0 0x40001000 0x0 0x1000>,
			       <0x0 0x000f8000 0x0 0x3000>,
			       <0x0 0x40100000 0x0 0x1000>;
			reg-names = "dbi", "elbi", "atu", "parf", "config";
			device_type = "pci";
			linux,pci-domain = <2>;
			bus-range = <0x00 0xff>;
			num-lanes = <2>;
			#address-cells = <3>;
			#size-cells = <2>;
			axi-halt-val = <0x1e>; /* increase halt window size to 1GB */
			id = <2>;

			ranges = <0x81000000 0 0x40200000 0x0 0x40200000 0 0x00100000>,   /* downstream I/O */
				 <0x82000000 0 0x40300000 0x0 0x40300000 0 0x0fd00000>; /* non-prefetchable memory */

			clocks = <&gcc GCC_PCIE2_AXI_M_CLK>,
				 <&gcc GCC_PCIE2_AXI_S_CLK>,
				 <&gcc GCC_PCIE2_AHB_CLK>,
				 <&gcc GCC_PCIE2_AUX_CLK>,
				 <&gcc GCC_PCIE2_AXI_S_BRIDGE_CLK>;

			clock-names = "axi_m",
				      "axi_s",
				      "ahb",
				      "aux",
				      "axi_bridge";

			assigned-clocks = <&gcc GCC_PCIE2_AUX_CLK>,
					<&gcc GCC_PCIE2_AXI_M_CLK>,
					<&gcc GCC_PCIE2_AXI_S_CLK>,
					<&gcc GCC_PCIE2_RCHNG_CLK>;

			assigned-clock-rates = <20000000>,
						<266666666>,
						<200000000>,
						<100000000>;

			resets = <&gcc GCC_PCIE2_PIPE_ARES>,
				 <&gcc GCC_PCIE2_CORE_STICKY_RESET>,
				 <&gcc GCC_PCIE2_AXI_M_ARES>,
				 <&gcc GCC_PCIE2_AXI_S_ARES>,
				 <&gcc GCC_PCIE2_AXI_M_STICKY_RESET>,
				 <&gcc GCC_PCIE2_AXI_S_STICKY_RESET>,
				 <&gcc GCC_PCIE2_AHB_ARES>,
				 <&gcc GCC_PCIE2_AUX_ARES>;

			reset-names = "pipe",
				      "sticky",
				      "axi_m",
				      "axi_s",
				      "axi_m_sticky",
				      "axi_s_sticky",
				      "ahb",
				      "aux";

			msi-parent = <&intc>;

			phys = <&pcie2_phy>;
			phy-names = "pciephy";

			status = "disabled";
		};
		/* 2L controller */
		pcie1: pcie@50000000 {
			compatible = "qcom,pcie-ipq9650";
			reg =  <0x0 0x50000000 0x0 0xf1d>,
			       <0x0 0x50000f20 0x0 0xa8>,
			       <0x0 0x50001000 0x0 0x1000>,
			       <0x0 0x000f0000 0x0 0x3000>,
			       <0x0 0x50100000 0x0 0x1000>;
			reg-names = "dbi", "elbi", "atu", "parf", "config";
			device_type = "pci";
			linux,pci-domain = <1>;
			bus-range = <0x00 0xff>;
			num-lanes = <2>;
			#address-cells = <3>;
			#size-cells = <2>;
			axi-halt-val = <0x1e>; /* increase halt window size to 1GB */
			id = <1>;

			ranges = <0x81000000 0 0x50200000 0x0 0x50200000 0 0x00100000>,   /* downstream I/O */
				 <0x82000000 0 0x50300000 0x0 0x50300000 0 0x0fd00000>; /* non-prefetchable memory */

			clocks = <&gcc GCC_PCIE1_AXI_M_CLK>,
				 <&gcc GCC_PCIE1_AXI_S_CLK>,
				 <&gcc GCC_PCIE1_AHB_CLK>,
				 <&gcc GCC_PCIE1_AUX_CLK>,
				 <&gcc GCC_PCIE1_AXI_S_BRIDGE_CLK>;

			clock-names = "axi_m",
				      "axi_s",
				      "ahb",
				      "aux",
				      "axi_bridge";

			assigned-clocks = <&gcc GCC_PCIE1_AUX_CLK>,
					<&gcc GCC_PCIE1_AXI_M_CLK>,
					<&gcc GCC_PCIE1_AXI_S_CLK>,
					<&gcc GCC_PCIE1_RCHNG_CLK>;

			assigned-clock-rates = <20000000>,
						<266666666>,
						<200000000>,
						<100000000>;

			resets = <&gcc GCC_PCIE1_PIPE_ARES>,
				 <&gcc GCC_PCIE1_CORE_STICKY_RESET>,
				 <&gcc GCC_PCIE1_AXI_M_ARES>,
				 <&gcc GCC_PCIE1_AXI_S_ARES>,
				 <&gcc GCC_PCIE1_AXI_M_STICKY_RESET>,
				 <&gcc GCC_PCIE1_AXI_S_STICKY_RESET>,
				 <&gcc GCC_PCIE1_AHB_ARES>,
				 <&gcc GCC_PCIE1_AUX_ARES>;

			reset-names = "pipe",
				      "sticky",
				      "axi_m",
				      "axi_s",
				      "axi_m_sticky",
				      "axi_s_sticky",
				      "ahb",
				      "aux";

			msi-parent = <&intc>;

			phys = <&pcie1_phy>;
			phy-names = "pciephy";

			status = "disabled";
		};

		/* 1L controller */
		pcie4: pcie@60000000 {
			compatible = "qcom,pcie-ipq9650";
			reg =  <0x0 0x60000000 0x0 0xf1d>,
			       <0x0 0x60000f20 0x0 0xa8>,
			       <0x0 0x60001000 0x0 0x1000>,
			       <0x0 0x80000 0x0 0x3000>,
			       <0x0 0x60100000 0x0 0x1000>;
			reg-names = "dbi", "elbi", "atu", "parf", "config";
			device_type = "pci";
			linux,pci-domain = <4>;
			bus-range = <0x00 0xff>;
			num-lanes = <1>;
			#address-cells = <3>;
			#size-cells = <2>;
			axi-halt-val = <0x1e>; /* increase halt window size to 1GB */
			id = <4>;

			ranges = <0x81000000 0 0x60200000 0x0 0x60200000 0 0x00100000>,   /* downstream I/O */
				 <0x82000000 0 0x60300000 0x0 0x60300000 0 0x0fd00000>; /* non-prefetchable memory */

			clocks = <&gcc GCC_PCIE4_AXI_M_CLK>,
				 <&gcc GCC_PCIE4_AXI_S_CLK>,
				 <&gcc GCC_PCIE4_AHB_CLK>,
				 <&gcc GCC_PCIE4_AUX_CLK>,
				 <&gcc GCC_PCIE4_AXI_S_BRIDGE_CLK>;

			clock-names = "axi_m",
				      "axi_s",
				      "ahb",
				      "aux",
				      "axi_bridge";

			assigned-clocks = <&gcc GCC_PCIE4_AUX_CLK>,
					<&gcc GCC_PCIE4_AXI_M_CLK>,
					<&gcc GCC_PCIE4_AXI_S_CLK>,
					<&gcc GCC_PCIE4_RCHNG_CLK>;

			assigned-clock-rates = <20000000>,
						<200000000>,
						<200000000>,
						<100000000>;

			resets = <&gcc GCC_PCIE4_PIPE_ARES>,
				 <&gcc GCC_PCIE4_CORE_STICKY_RESET>,
				 <&gcc GCC_PCIE4_AXI_M_ARES>,
				 <&gcc GCC_PCIE4_AXI_S_ARES>,
				 <&gcc GCC_PCIE4_AXI_M_STICKY_RESET>,
				 <&gcc GCC_PCIE4_AXI_S_STICKY_RESET>,
				 <&gcc GCC_PCIE4_AHB_ARES>,
				 <&gcc GCC_PCIE4_AUX_ARES>;

			reset-names = "pipe",
				      "sticky",
				      "axi_m",
				      "axi_s",
				      "axi_m_sticky",
				      "axi_s_sticky",
				      "ahb",
				      "aux";

			msi-parent = <&intc>;

			phys = <&pcie4_phy>;
			phy-names = "pciephy";

			status = "disabled";
		};

		/* 1L controller */
		pcie0: pcie@70000000 {
			compatible = "qcom,pcie-ipq9650";
			reg =  <0x0 0x70000000 0x0 0xf1d>,
			       <0x0 0x70000f20 0x0 0xa8>,
			       <0x0 0x70001000 0x0 0x1000>,
			       <0x0 0x80000 0x0 0x3000>,
			       <0x0 0x70100000 0x0 0x1000>;
			reg-names = "dbi", "elbi", "atu", "parf", "config";
			device_type = "pci";
			linux,pci-domain = <0>;
			bus-range = <0x00 0xff>;
			num-lanes = <1>;
			#address-cells = <3>;
			#size-cells = <2>;
			axi-halt-val = <0x1e>; /* increase halt window size to 1GB */
			id = <0>;

			ranges = <0x81000000 0 0x70200000 0x0 0x70200000 0 0x00100000>,   /* downstream I/O */
				 <0x82000000 0 0x70300000 0x0 0x70300000 0 0x0fd00000>; /* non-prefetchable memory */

			clocks = <&gcc GCC_PCIE0_AXI_M_CLK>,
				 <&gcc GCC_PCIE0_AXI_S_CLK>,
				 <&gcc GCC_PCIE0_AHB_CLK>,
				 <&gcc GCC_PCIE0_AUX_CLK>,
				 <&gcc GCC_PCIE0_AXI_S_BRIDGE_CLK>;

			clock-names = "axi_m",
				      "axi_s",
				      "ahb",
				      "aux",
				      "axi_bridge";

			assigned-clocks = <&gcc GCC_PCIE0_AUX_CLK>,
					<&gcc GCC_PCIE0_AXI_M_CLK>,
					<&gcc GCC_PCIE0_AXI_S_CLK>,
					<&gcc GCC_PCIE0_RCHNG_CLK>;

			assigned-clock-rates = <20000000>,
						<200000000>,
						<200000000>,
						<100000000>;

			resets = <&gcc GCC_PCIE0_PIPE_ARES>,
				 <&gcc GCC_PCIE0_CORE_STICKY_RESET>,
				 <&gcc GCC_PCIE0_AXI_M_ARES>,
				 <&gcc GCC_PCIE0_AXI_S_ARES>,
				 <&gcc GCC_PCIE0_AXI_M_STICKY_RESET>,
				 <&gcc GCC_PCIE0_AXI_S_STICKY_RESET>,
				 <&gcc GCC_PCIE0_AHB_ARES>,
				 <&gcc GCC_PCIE0_AUX_ARES>;

			reset-names = "pipe",
				      "sticky",
				      "axi_m",
				      "axi_s",
				      "axi_m_sticky",
				      "axi_s_sticky",
				      "ahb",
				      "aux";

			msi-parent = <&intc>;

			phys = <&pcie0_phy>;
			phy-names = "pciephy";

			status = "disabled";
		};
		watchdog: non-sec@f410000 {
			compatible = "qcom,apss-wdt-ipq9650", "qcom,kpss-wdt";
			#address-cells = <2>;
			#size-cells = <2>;
			reg =  <0x0 0xf410000 0x0 0x1000>;
			clocks = <&sleep_clk>;
			timeout-sec = <30>;
			status = "okay";
		};
	};
};

&tlmm {
	uart1_pins: uart1-state {
		bootph-all;
	};

	sdc_default_state: sdc-default-state {
		clk-pins {
			pins = "gpio5";
			function = "sdc_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			pins = "gpio4";
			function = "sdc_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			pins = "gpio0", "gpio1", "gpio2", "gpio3";
			function = "sdc_data";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	spi0_pinmux: spi0 {
		spi0_sclk {
			pins = "gpio6";
			function = "qup_se0_l2";
			drive-strength = <8>;
			bias-pull-down;
		};

		spi0_cs0 {
			pins = "gpio7";
			function = "qup_se0_l3";
			drive-strength = <8>;
			bias-pull-down;
		};

		spi0_miso {
			pins = "gpio8";
			function = "qup_se0_l0";
			drive-strength = <8>;
			bias-pull-down;
		};

		spi0_mosi {
			pins = "gpio9";
			function = "qup_se0_l1";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	qspi_pinmux: nand {
		qspi_data {
			pins = "gpio0", "gpio1", "gpio2","gpio3";
			function = "qspi_data";
			drive-strength = <8>;
			bias-pull-up;
		};

		qspi_cs_n {
			pins = "gpio4";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-pull-up;
                };

		qspi_clk {
			pins = "gpio5";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};
        };
};

&sdhc {
	bus-width = <4>;
	max-frequency = <192000000>;
	mmc-ddr-1_8v;
	non-removable;
	pinctrl-0 = <&sdc_default_state>;
	pinctrl-names = "default";
	sdhci-caps-mask = <0x0 0x04000000>;
	sdhci-caps = <0x0 0x04000000>;
	resets = <&gcc GCC_SDCC_BCR>;
	reset-names = "bcr_rst";
	status = "okay";
};

&qupv3 {
	status = "okay";
	uart1: serial@1a98000 {
		pinctrl-0 = <&uart1_pins>;
		pinctrl-names = "default";
		qup-se-fw-load = <&uart1_fw>;
		status = "okay";
	};

	uart1_fw: uart_firmware@0 {
		compatible = "qcom,ipq9650-geni-uart-fw-v1", "qcom,geni-uart-fw-v1";
		reg = <0 0x01a98000 0 0x4000>;
		status = "okay";
	};

	spi0: spi@1a80000 {
		compatible = "qcom-ipq9650-geni-spi","qcom-ipq5424-geni-spi";
		reg = <0 0x1a80000 0 0x4000>;
		reg-names = "se_phys";
		clocks = <&gcc GCC_QUPV3_SPI0_CLK>;
		clock-names = "se-spi-clk";
		clock-frequency = <50000000>;
		nor-blk-enable;
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		qup-se-fw-load = <&spi0_fw>;
		tx-fifo-depth=<32>;

		pinctrl-0 = <&spi0_pinmux>;
		pinctrl-names = "default";

		nor-flash@0 {
			compatible = "jedec,spi-nor";
			reg = <0 0 0 0>;
			spi-max-frequency = <50000000>;
		};
	};

	spi0_fw: spi_firmware@0 {
		compatible = "qcom,ipq9650-geni-spi-fw-v1", "qcom,geni-spi-fw-v1";
		reg = <0 0x1a80000 0 0x4000>;
		reg-names = "se_phys";
		status = "okay";
	};

	i2c0: i2c@1a88000 {
		compatible = "qcom,geni-i2c";
		reg = <0x0 0x1a88000 0x0 0x4000>;
		reg-names = "se_phys";
		assigned-clocks = <&gcc GCC_QUPV3_I2C_SE2_CLK>;
		assigned-clock-rates = <64000000>;
		clocks = <&gcc GCC_QUPV3_I2C_SE2_CLK>;
		clock-names = "se";
		clock-frequency = <400000>;
		qup-se-fw-load = <&i2c0_fw>;
		qcom,geni-se-clk-32mhz;
		status = "disabled";
	};

	i2c0_fw: i2c0_firmware@0 {
		compatible = "qcom,ipq9650-geni-i2c-fw-v1", "qcom,geni-i2c-fw-v1";
		reg = <0x0 0x1a88000 0x0 0x4000>;
		status = "disabled";
	};

	i2c1: i2c@1a8c000 {
		compatible = "qcom,geni-i2c";
		reg = <0x0 0x1a8c000 0x0 0x4000>;
		reg-names = "se_phys";
		assigned-clocks = <&gcc GCC_QUPV3_I2C_SE3_CLK>;
		assigned-clock-rates = <64000000>;
		clocks = <&gcc GCC_QUPV3_I2C_SE3_CLK>;
		clock-names = "se";
		clock-frequency = <400000>;
		qup-se-fw-load = <&i2c1_fw>;
		qcom,geni-se-clk-32mhz;
		status = "disabled";
	};

	i2c1_fw: i2c1_firmware@0 {
		compatible = "qcom,ipq9650-geni-i2c-fw-v1", "qcom,geni-i2c-fw-v1";
		reg = <0x0 0x1a8c000 0x0 0x4000>;
		status = "disabled";
	};
};
